LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
LLM_BASE_URL=https://api.openai.com/v1
REDIS_HOST=localhost
REDIS_PORT=6379
CHROMA_PERSIST_DIR=./data/chroma
REPOS_DIR=./data/repos
HISTORY_DB=./data/history.db
REPO_CACHE_DIR=./data/cache
# Optional: set a token to require X-API-Token on all API calls (leave empty = no auth, localhost only)
API_TOKEN=
# Optional: comma-separated allowed CORS origins (empty = localhost defaults)
CORS_ORIGINS=
# Set to 1 to echo exception details in 500 responses
DEBUG=0